LOG_LEVEL=INFO
METRICS_ENABLED=true

# Secret key for HMAC-SHA256 auth token hashing. Required in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_KEY=

APP_TIMEZONE=UTC

API_PORT=8000
INGEST_PORT=8001
PROCESSOR_PORT=8002

IPC_SOCKET_PATH=/var/run/telemetria/ipc.sock

# ---- App database (control plane, CLI, migrations) -------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=telemetria
DB_USER=telemetria
DB_PASSWORD=telemetria

# ---- Ingest role (read-only auth token resolver, same DB as above) -----------------
# Set after running: docker compose run --rm telemetria-cli python -m telemetria.db.bootstrap
INGEST_DB_USER=telemetria_ingest
INGEST_DB_PASSWORD=changeme

# ---- Sink (processor) -------------------------------------------------------
# "loki" pushes events to Grafana Loki (default). "null" discards all events.
SINK_PROVIDER=loki

# ---- Loki sink (used when SINK_PROVIDER=loki) --------------------------------
LOKI_URL=http://loki:3100
LOKI_TIMEOUT_SECONDS=5
LOKI_COMPRESSION=gzip

# ---- Grafana ----------------------------------------------------------------
GRAFANA_USER=john.doe
GRAFANA_PASSWORD=changeme

# ---- Advanced / fine-tuning --------------------------------------------------
# Ingest API documentation (Scalar at :8001/). Admin docs follow ADMIN_API_ENABLED.
# API_DOCS_ENABLED=true  # enables Scalar docs on ingest (:8001/) and processor (:8002/)
#
# Admin REST API — CRUD for projects, apps, and auth tokens at /admin/v1.
# ADMIN_API_ENABLED=true
# ADMIN_API_KEY=
#
# Loki multi-tenant: set X-Scope-OrgID on every push request.
# LOKI_TENANT_ID=myorg
#
# Processor batch tuning:
# BATCH_MAX_SIZE=500
# BATCH_MAX_WAIT_SECONDS=1.0
#
# Sink retry policy:
# SINK_MAX_RETRIES=3
# SINK_RETRY_BASE_SECONDS=0.25
# SINK_RETRY_MAX_SECONDS=10.0

